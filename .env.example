# Odysseus UI — Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================
# LLM Configuration
# ============================================================

# Primary LLM host (default: localhost)
LLM_HOST=localhost

# Additional LLM hosts, comma-separated (for model discovery)
# Use hostnames/IPs only; Odysseus scans common serve ports, including Ollama's 11434.
# LLM_HOSTS=llm-host.local,backup-llm.local

# Optional Ollama base URL. In Docker, host Ollama is usually reachable here
# when started with OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# OpenAI API key (only needed if using OpenAI models).
# Do not commit real keys. Keep this commented until needed.
# OPENAI_API_KEY=your_openai_api_key_here

# Research service LLM endpoint
# RESEARCH_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions

# ============================================================
# Search & Web
# ============================================================

# SearXNG instance URL (self-hosted, for web search).
# Docker Compose overrides this to http://searxng:8080 for in-network access.
SEARXNG_INSTANCE=http://localhost:8080

# Optional SearXNG cookie/CSRF secret. If blank, Docker generates one on first boot
# and stores it in the searxng-data volume.
# SEARXNG_SECRET=

# ============================================================
# Database
# ============================================================

# SQLite database path (default: sqlite:///./data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Auth & Security
# ============================================================

# Enable authentication (default: true)
# AUTH_ENABLED=true

# Host port for the Odysseus web UI in Docker Compose.
# Change this if another local service already uses 7000 (macOS AirPlay often does).
# APP_PORT=7000

# Development-only auth bypass for loopback requests.
# Keep false for Docker, LAN, reverse proxy, and any shared deployment.
# LOCALHOST_BYPASS=false

# Optional: pre-seed the first admin password during setup.
# Do not commit a real password.
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot

# CORS allowed origins (default: localhost-only; restrict to your public origin in production)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# ============================================================
# ChromaDB (vector store)
# ============================================================

# ChromaDB service host.
# Manual host run: localhost:8100 when using `docker run -p 8100:8000 chromadb/chroma`.
# Docker Compose overrides these to chromadb:8000 for in-network access.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Docker Compose host-port bind addresses for bundled services.
# Defaults are loopback-only for safety. To expose ntfy only on Tailscale,
# set NTFY_BIND to your host's Tailscale IP and update NTFY_BASE_URL.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Example:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# Embedding API endpoint (OpenAI-compatible /v1/embeddings)
# Default: http://{LLM_HOST}:11434/v1/embeddings (ollama)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Embedding model name (must be available at the endpoint above)
# EMBEDDING_MODEL=all-minilm:l6-v2

# Local fallback embedding model (used when no HTTP embedding API is available)
# Uses fastembed (ONNX) — downloads model on first run (~50MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # defaults to ~/.cache/fastembed

# ============================================================
# Misc
# ============================================================

# Cleanup interval in hours (default: 24)
# CLEANUP_INTERVAL_HOURS=24

# In-process email pollers (default: on). Set to 0 if you're driving
# polling from cron / systemd via `scripts/odysseus-mail poll-scheduled`
# and `scripts/odysseus-mail poll-summary`, otherwise both schedulers
# race on the same SQLite.
# ODYSSEUS_INPROCESS_POLLERS=1

# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks. Calendar reminders are
# frontend-driven (polling /api/notes from the browser) so no gate is
# needed there.
# ODYSSEUS_INPROCESS_TASKS=1

# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host. Set to an SSH host alias
# if you intentionally want scheduled scripts to run remotely.
# ODYSSEUS_SCRIPT_HOST=localhost

# ============================================================
# Owner approval gate (src/approval_gate.py)
# ============================================================
# Consequential agent tools (bash, python, write_file, send_email, settings/
# token changes, ...) are held until the owner replies `approve <id>` on
# Telegram. Fails closed: deny, timeout, or any error means the action is NOT run.
#   telegram (default) - gate the Telegram agent session only
#   all                - gate every session (each web-UI bash pages the owner)
#   off                - disabled
# Any other value is treated as `all`.
# APPROVAL_GATE_MODE=telegram
# APPROVAL_TIMEOUT_SECONDS=300
# APPROVAL_MAX_PENDING=3
# Anti-spam: identical actions are auto-denied (no ping) this long after a denial/expiry,
# and the owner is pinged at most this many times per hour (one notice when hit).
# APPROVAL_REPEAT_COOLDOWN_SECONDS=600
# APPROVAL_MAX_REQUESTS_PER_HOUR=10
# Bare harmless system-info commands (df -h, free -h, uname -a, date, uptime, ...) run
# without a ping (still audited). Anything with paths/pipes/chaining is still gated.
# APPROVAL_AUTO_ALLOW_READONLY=1
# One-tap Approve/Deny buttons under each approval ping (typed 'approve <id>' always still works). 0 = text only.
# APPROVAL_BUTTONS=1

# ============================================================
# AURIX brain (memory tiers + wiki) mounted read-only into the app at /aurix
# ============================================================
# Host directory of the live AURIX brain (must contain memory/ and wiki/). Compose mounts them at /aurix.
# AURIX_BRAIN_HOST=/home/YOURUSER/ai/brain
# Inside the container these must be the /aurix paths, NOT host paths:
# AURIX_BRAIN=/aurix
# AURIX_WIKI=/aurix/wiki
# AURIX_MEMORY=/aurix/memory
# Embeddings: the code reads EMBEDDING_URL (not EMBEDDING_API). Unset = local FastEmbed (works offline).
# LLM_HOST is a HOSTNAME only: the code appends :11434 itself ('localhost:11434' became localhost:11434:11434).

# ============================================================
# God's Eye View (gods_eye/, the real 3D globe) - separate container, opt-in keys
# ============================================================
# Where it is published on the host. Default is localhost only; set this to the host's Tailscale IP to open it from
# your PC at http://THAT-IP:4173 (do NOT use 0.0.0.0: it would expose the key broker to the whole LAN).
# GODSEYE_BIND=100.x.y.z
# GODSEYE_PORT=4173
# Works with no keys (Esri imagery, keyless terrain, flights, satellites, quakes, cameras). Optional upgrades:
# GEV_CESIUM_ION_TOKEN=          # free community token -> photorealistic 3D tiles (personal, non-commercial)
# GEV_GOOGLE_MAPS_API_KEY=       # restrict it (HTTP referrer + API) in Google Cloud first

# ============================================================
# Free / multi-key model routing (src/key_rotation.py, src/model_router.py)
# ============================================================
# Several keys per provider, comma-separated (max 5). On 401/402/429 the key cools down for 10 minutes and the
# next one is used. Applies only to endpoints with no key of their own (or whose key is one of these).
# OPENROUTER_API_KEYS=sk-or-...,sk-or-...
# OpenCode Zen (https://opencode.ai/zen, has a rotating free tier). Setting a key adds it to model discovery:
# add an endpoint with base URL https://opencode.ai/zen/v1 to chat with it.
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_API_KEYS=

# Monthly cap on tokens sent to hosted, non-free models (src/spend_ledger.py). At the cap paid calls stop and
# the fallback chain continues on local/free models. Blank = no cap (usage is still recorded for the dashboard).
# AURIX_MONTHLY_PAID_TOKEN_CAP=2000000
# Folders the wiki_outline / wiki_read tools index (default: $AURIX_BRAIN/wiki and $AURIX_BRAIN/memory/longterm)
# AURIX_PAGE_INDEX_DIRS=/aurix/wiki,/aurix/memory/longterm

# ============================================================
# Opt-in MCP servers (src/mcp_presets.py)
# ============================================================
# blender: Blender over MCP (needs `uv` and the Blender add-on; safe mode on unless BLENDER_MCP_SAFE_MODE=0)
# context-mode: sandboxes and indexes bulky tool output so less of it reaches the model (needs Node.js)
# AURIX_MCP_PRESETS=blender,context-mode
# Answer-first replies in chat/agent mode (src/foundation/skills.py: adhd, archify, ponytail)
# AURIX_OUTPUT_STYLE=adhd

# ============================================================
# Opt-in extras (compose profile "extras": FileBrowser + ReClip)
# ============================================================
# COMPOSE_PROFILES=extras
# EXTRAS_BIND=127.0.0.1           # or the host's Tailscale IP; never 0.0.0.0
# FILEBROWSER_PORT=8088
# FILEBROWSER_ROOT=./data/aurix-brain
# FILEBROWSER_MOUNT_MODE=ro       # rw to allow edits
# FILEBROWSER_ADMIN_PASSWORD=     # blank = random, printed once in `docker compose logs filebrowser`
# RECLIP_PORT=8899

# ============================================================
# Knowledge graph (neo4j service + src/graph_memory.py)
# ============================================================
# REQUIRED by docker-compose.yml (the neo4j container will not start without it). Generate one:  openssl rand -hex 24
# NEO4J_PASSWORD=

# ============================================================
# Timezone (scheduled tasks + standing missions)
# ============================================================
# IANA name. Scheduled times ("07:00") are read in THIS zone. Unset means UTC.
# AURIX_TIMEZONE=America/Denver
# Optional morning digest to Telegram, once a day at this local time:
# AURIX_DIGEST_AT=07:00

# ============================================================
# Mission sandbox (mission_sandbox/, src/foundation/sandbox.py)
# ============================================================
# Mission bash/python run in an isolated container with no secrets, no internet, no LAN.
# The token authenticates the app to it. Generate one:  openssl rand -hex 32
# SANDBOX_TOKEN=
# SANDBOX_URL=http://sandbox-gateway:8765

# ============================================================
# Sandbox model path, standing missions, coding agent
# ============================================================
# Where the llm-gateway forwards model calls from the sandbox (inference endpoints only: it cannot
# pull/delete/create models). Defaults to the Docker host's own Ollama; point it at another machine
# on your network instead, e.g. over Tailscale (100.x.x.x:11434) or your LAN.
# LLM_UPSTREAM=host.docker.internal:11434
# Model the sandbox's coding agent (OpenHands) and scripts ask for:
# SANDBOX_LLM_MODEL=qwen2.5:7b
# Standing (scheduled) missions: the scheduler pass runs once a minute. 0 turns it off entirely.
# AURIX_STANDING_ENABLED=1
# Watchdog: AURIX messages you about broken audit chain / full disk / dead sandbox / stuck mission (once per
# problem, re-alerts every 6 h). Minutes between checks; 0 turns it off.
# AURIX_WATCHDOG_MINUTES=5
# software_dev missions run the OpenHands agent in the sandbox. If OpenHands is not installed in the
# image the step falls back to the normal chat agent (default). Set 0 to block instead:
# AURIX_OPENHANDS_FALLBACK=1

# ============================================================
# Remote Ollama (src/remote_inference.py)
# ============================================================
# When a session's Ollama endpoint is on ANOTHER machine (e.g. the GPU box over
# Tailscale), the resource governor must not size models from THIS host's RAM.
# List the models that remote machine actually has; the governor picks only from
# these (largest for agent/high-significance turns, smallest for light chat).
# Unset = keep the session's own model (usually "auto", which will fail).
# AURIX_REMOTE_MODELS=qwen2.5:3b,qwen2.5:7b

# ============================================================
# GPU support (Docker Compose)
# ============================================================
# Pass the host GPU into the odysseus container. Default (unset) = CPU.
# COMPOSE_FILE is a native `docker compose` feature: a colon-separated
# list of files merged left-to-right. Pick ONE GPU line below, or leave
# all commented for CPU.
#
# NVIDIA (requires nvidia-container-toolkit + `nvidia-ctk runtime
# configure --runtime=docker` on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
#
# AMD ROCm (requires ROCm drivers on the host):
# COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
#
# These overlays only expose the GPU devices. The slim Odysseus image
# still needs CUDA/ROCm userspace via Cookbook -> Dependencies (vLLM,
# llama-cpp-python, etc.) before models can actually serve on GPU.

# ============================================================
# Your machines (kept out of the code: the repository is public)
# ============================================================
# AURIX_HOMELAB_LINKS="Name|http://host:port;Name 2|http://host2:port"   # Command Center homelab links
# AURIX_GPU_HOST=100.64.0.10                      # GPU box's Tailscale address (capability probe, spec PoC)
# AURIX_GPU_OLLAMA_URL=http://100.64.0.10:11434   # same box's Ollama, for the LiteLLM PoC
# AURIX_GPU_MAC=AA:BB:CC:DD:EE:FF                 # GPU box's network card, for wake-on-LAN (unset = no wake)
# AURIX_LAN_BROADCAST=10.0.0.255                  # your LAN's broadcast address (wake-on-LAN)
# AURIX_LAN_URL=http://<server-lan-ip>:7000       # GamePilot pairing link on home Wi-Fi
# AURIX_TAILNET_URL=http://<server>.<tailnet>.ts.net:7000   # GamePilot pairing link over Tailscale
