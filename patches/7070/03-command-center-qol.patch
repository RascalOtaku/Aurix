--- a/static/command.html
+++ b/static/command.html
@@ -398,6 +398,73 @@
     if (c.border) r.setProperty("--border", c.border); if (c.red) r.setProperty("--red", c.red); }
 } catch (e) { /* default theme */ }

+/* ---- QoL: keyboard shortcuts, tab persistence, auto-refresh ---- */
+(function () {
+  "use strict";
+  var TAB_KEY = "aurix-command-tab";
+  var REFRESH_KEY = "aurix-command-autorefresh";
+  var REFRESH_MS = 60000;
+
+  function tabs() {
+    return Array.prototype.slice.call(document.querySelectorAll(".tabbtn[data-tab]"));
+  }
+  function panels() {
+    return Array.prototype.slice.call(document.querySelectorAll(".tabpanel[data-tab]"));
+  }
+  function activate(name, save) {
+    var found = false;
+    tabs().forEach(function (b) {
+      var on = b.getAttribute("data-tab") === name;
+      b.classList.toggle("active", on);
+      if (on) found = true;
+    });
+    panels().forEach(function (p) {
+      p.classList.toggle("active", p.getAttribute("data-tab") === name);
+    });
+    if (found && save !== false) {
+      try { localStorage.setItem(TAB_KEY, name); } catch (e) {}
+    }
+    return found;
+  }
+
+  // Restore last tab on load.
+  try {
+    var last = localStorage.getItem(TAB_KEY);
+    if (last) activate(last, false);
+  } catch (e) {}
+
+  // Remember tab on click (in addition to any existing handler).
+  tabs().forEach(function (b) {
+    b.addEventListener("click", function () {
+      try { localStorage.setItem(TAB_KEY, b.getAttribute("data-tab")); } catch (e) {}
+    });
+  });
+
+  // Keyboard: 1-7 switches tabs, r refreshes data (if a refresh fn exists).
+  document.addEventListener("keydown", function (ev) {
+    if (/^(INPUT|TEXTAREA|SELECT)$/.test((ev.target && ev.target.tagName) || "")) return;
+    var t = tabs();
+    if (ev.key >= "1" && ev.key <= String(t.length)) {
+      var b = t[parseInt(ev.key, 10) - 1];
+      if (b) { b.click(); ev.preventDefault(); }
+    } else if (ev.key === "r" || ev.key === "R") {
+      if (typeof window.aurixRefresh === "function") { window.aurixRefresh(); ev.preventDefault(); }
+      else if (typeof loadAll === "function") { loadAll(); ev.preventDefault(); }
+    }
+  });
+
+  // Auto-refresh every 60s, toggleable, persisted. Off by default.
+  var timer = null;
+  function setAuto(on) {
+    try { localStorage.setItem(REFRESH_KEY, on ? "1" : "0"); } catch (e) {}
+    if (timer) { clearInterval(timer); timer = null; }
+    if (on) {
+      timer = setInterval(function () {
+        if (typeof window.aurixRefresh === "function") window.aurixRefresh(true);
+        else if (typeof loadAll === "function") loadAll(true);
+      }, REFRESH_MS);
+    }
+    var btn = document.getElementById("autorefresh-toggle");
+    if (btn) { btn.textContent = on ? "Auto: on" : "Auto: off"; btn.classList.toggle("active", !!on); }
+  }
+  // Expose for a header toggle button (add <button id="autorefresh-toggle"> in header).
+  window.aurixAutoRefresh = setAuto;
+  try {
+    if (localStorage.getItem(REFRESH_KEY) === "1") setAuto(true);
+  } catch (e) {}
+})();
+
 </script>
